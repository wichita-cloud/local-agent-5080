# secrets.env: optional keys. Copy to config/secrets.env, then `chmod 600 config/secrets.env`.
# This file is git-ignored. Never commit real values. Everything works without them; you just lose the feature.

BRAVE_API_KEY=            # enables the agent's web_search tool. Get one at https://brave.com/search/api/ (Search plan; see the
                          # README "Accounts" section). Empty = no web search; the agent can still read pages you link to.
GATEWAY_TOKEN=            # dashboard auth token. Empty = generated once by gateway-up.sh and saved back here,
                          # so the token stays the same across restarts (otherwise the browser has to re-pair each time).
