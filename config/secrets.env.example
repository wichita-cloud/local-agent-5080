# secrets.env: optional keys. Copy to config/secrets.env, then `chmod 600 config/secrets.env`.
# This file is git-ignored. Never commit real values. Everything works without them; you just lose the feature.

BRAVE_API_KEY=            # optional: web search for the agent and the overnight job. Empty = no web search; the agent can still read pages you link to.
                          # How to get a key (about 5 minutes): docs/OVERNIGHT.md, "Getting a Brave Search API key".
TAVILY_API_KEY=           # optional, for the overnight job: Tavily search, email sign-up, NO card, 1,000 free searches a month. docs/OVERNIGHT.md
GATEWAY_TOKEN=            # dashboard auth token. Empty = generated once by gateway-up.sh and saved back here,
                          # so the token stays the same across restarts (otherwise the browser has to re-pair each time).

# Optional: a Jina AI key, used only when JINA_FALLBACK=on (config/stack.env). Without one Jina allows 20 pages a minute;
# with one, 500. The key also ties those requests to your Jina account. Get one at jina.ai.
JINA_API_KEY=
