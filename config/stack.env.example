# stack.env: every tunable in one place. Copy to config/stack.env (git-ignored) and edit there.
# Sourced by bin/lib.sh, so all scripts see the same values. Plain KEY=VALUE, and $HOME expands.

# ── Model ────────────────────────────────────────────────────────────────────────
ACTIVE_MODEL=qwen3.5-27b-iq4xs          # a profile in models/<name>.env (bin/model.sh use <name> rewrites this line)
MODEL_DIR=$HOME/models                  # where your .gguf files live (mounted read-only into the container)
MODEL_ALIAS=local-model                 # the name every client asks for; it stays the same when you switch models

# ── llama.cpp container ──────────────────────────────────────────────────────────
# Pinned by digest: the exact May-2026 server-cuda build this stack was measured on (RTX 5080 / sm_120 OK).
# To try a newer build, change this, then run bin/bench.sh before trusting it.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:25f88607814dba0b45e00f00fb59203912c7c221a2184fab6455f952914308b7
LLAMA_CONTAINER=local-llama
LLAMA_CPUSET=0-7                        # pin llama to these cores; keep THREADS in the profile equal to the count

# ── Ports (all loopback inside WSL; Windows reaches them via localhost forwarding) ──
LLAMA_PORT=9080          # llama.cpp, same port inside and outside the container (avoids a cross-wire seen with a 2nd :8080 container)
SHIM_PORT=19080          # readiness gate (what OpenClaw talks to)
RAG_PORT=9081            # memory proxy
MEMORY_PORT=5766         # memory service
GATEWAY_PORT=18789       # OpenClaw gateway / dashboard
CONSOLE_PORT=18800       # the local web console (console/server.py): health, models, character

# ── Voice (optional: bin/voice-install.sh; then the console's Voice tab) ─────────────────────
VOICE_PORT=8880          # local text-to-speech server (OpenAI-compatible /v1/audio/speech), loopback only
VOICE_ENGINE=nano        # nano = fast (~1.4x real time on 8 cores); turbo = a little richer, ~2x slower
VOICE_CPUSET=8-15        # CPU cores for speech, kept apart from LLAMA_CPUSET so speaking never slows the model
VOICE_NAME=default       # the voice the agent speaks with (bin/voice.sh use <name> rewrites this line)
VOICE_REPLIES=inbound    # spoken replies in messaging apps: off | inbound (when you send a voice note) | always
SEARCH_SHIM_PORT=18890   # gives the agent's web_search tool the local SearXNG (bin/searxng.sh) when you have no Brave key
STT_PORT=8890            # local speech-to-text server (you speaking to the agent: console microphone, phone voice notes)
STT_MODEL=small.en       # tiny.en | base.en | small.en | medium.en (drop ".en" for other languages). Bigger = more accurate, slower
VOICE_VENV=$HOME/.local/share/local-agent/voice-venv
VOICE_DIR=$HOME/.local/share/local-agent/voices      # your voice recordings; outside the repo, never committed

# ── Guards ───────────────────────────────────────────────────────────────────────
VRAM_FLOOR_MIB=250       # alarm below this much free VRAM (allocations are about to spill or fail)
DECODE_FLOOR_MS=60       # alarm if median decode is slower than this (healthy ≈ 20 ms/token)
SPILL_MAX_MIB=150        # verify.sh fails if the WSL VM has more than this in shared (system) GPU memory AND under 1 GiB VRAM is free

# ── Paths ────────────────────────────────────────────────────────────────────────
STATE_DIR=$HOME/.local/state/local-agent      # logs, flags, pid files
MEMORY_DB=$HOME/.local/share/local-agent/memory-db
VENV=$HOME/.local/share/local-agent/venv      # Python venv for the services

# ── Agent ────────────────────────────────────────────────────────────────────────
OPENCLAW_VERSION=2026.3.11    # patches in patches/openclaw-2026.3.11 are written against exactly this
OPENCLAW_WORKSPACE=$HOME/.openclaw/workspace   # the agent's character files and notes (edit them in the console)
USER_TIMEZONE=                # e.g. Europe/London or America/New_York; empty = system timezone. Wrong TZ makes the agent misread the time of day.
BOOTSTRAP_MAX_CHARS=26000     # per-file cap on instruction files injected each turn (OpenClaw default 20000 truncates silently)
MAX_REPLY_TOKENS=8192
WINDOWS_DISTRO=Ubuntu-22.04   # informational; the .bat helpers in windows/ name the distro directly

# ── Security: set by bin/security.sh (asked at install; or the console's Security tab). Shown here for reference ──
#SECURITY_PROFILE=protected  # protected = the agent's commands and file edits run in a Docker sandbox | standard = directly on your PC
#SANDBOX_NETWORK=off         # off = commands inside the sandbox can't reach the internet | on = they can (pip install, git clone)
#SHARED_FOLDERS=             # extra folders the agent may use: "/full/path|ro;/other/path|rw" (bin/security.sh share add ...)

# ── Overnight work (docs/OVERNIGHT.md; the console's Overnight tab changes these) ────────────────────────────────
#OVERNIGHT=off                       # on = research your topics and prepare ideas while you're away, inside the window below
OVERNIGHT_START=01:00                # the window, local 24-hour time; it may run past midnight (23:00 to 06:00)
OVERNIGHT_END=06:00
OVERNIGHT_IDLE_MINUTES=10            # wait until you haven't chatted with the agent for this long
OVERNIGHT_TOPICS=""                  # what to look into, in your own words (also picked from your recent notes)
OVERNIGHT_SEARCH=auto               # web search provider: auto | tavily (email sign-up, no card) | searxng (local, no account) | brave (card)
SEARXNG_PORT=18888                  # where bin/searxng.sh listens (127.0.0.1 only)
OVERNIGHT_SEARCHES_PER_NIGHT=8       # hard cap on web searches per night
OVERNIGHT_MONTHLY_SEARCH_LIMIT=300   # hard cap per month, counted by this job only: keep it under your provider's quota (Tavily free: 1,000; Brave credit: ~1,000) minus what the agent uses in the day
