# SMOKE-TEST PROFILE: a small model that fits with lots of room. Use it to prove the pipeline works
# (GPU, container, gate, memory, agent) in five minutes before downloading a 14 GB model, or to rule
# out the model when debugging. It is not a good agent model.
# MEASURED 2026-10-17 on an RTX 5080 (bench.sh): 8.0 ms/token decode, 5,693 tok/s prefill, 8.2 GB VRAM free at 32k.

DESCRIPTION="Qwen3-8B Q4_K_M, 32k context (pipeline smoke test)"
MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
MODEL_URL="https://huggingface.co/Qwen/Qwen3-8B-GGUF/resolve/main/Qwen3-8B-Q4_K_M.gguf"   # the console's Download button / bin/model.sh download use this
MEASURED=yes        # yes = EXPECT_* below came from bench.sh on an RTX 5080; no = estimates until you bench
MIN_BYTES=4500000000
CTX=32768
UBATCH=512
BATCH=2048
THREADS=8
GPU_LAYERS=99
KV_ARGS="-ctk q8_0 -ctv q8_0 -fa on"
SAMPLING="--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0 --repeat-penalty 1.0"
REASONING=off
EXTRA_ARGS=""
MIN_FREE_MIB=7000
EXPECT_DECODE_MS=8
EXPECT_PREFILL_TPS=5600
