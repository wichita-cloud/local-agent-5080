# MID-SIZE PROFILE: Qwen3-14B (dense), Q4_K_M, 40k context.
# Roughly twice as fast as the 27B and leaves ~3.5 GB of VRAM free, so it tolerates a browser or a light game on the
# 5080. Noticeably weaker at multi-step tool use and long instructions than the 27B. Good for testing, for a
# "fast mode", or for machines that also do other GPU work.
# MEASURED 2026-10-17 on an RTX 5080 (bench.sh): 12.1 ms/token decode, 3,082 tok/s prefill, 3.5 GB VRAM free at 40k.
# With the monitor on the 5080 (2026-10-18): 13.6 ms/token, 3,086 tok/s, 3.0 GB free. No cable change needed.

DESCRIPTION="Qwen3-14B dense, Q4_K_M, 40k context (faster, lighter; weaker tool use)"
MODEL_FILE=Qwen3-14B-Q4_K_M.gguf
MODEL_URL="https://huggingface.co/Qwen/Qwen3-14B-GGUF/resolve/main/Qwen3-14B-Q4_K_M.gguf"   # the console's Download button / bin/model.sh download use this
MEASURED=yes        # yes = EXPECT_* below came from bench.sh on an RTX 5080; no = estimates until you bench
MIN_BYTES=8800000000

CTX=40960        # a standard transformer: every layer has a KV cache, so context costs more per token than on Qwen3.5
UBATCH=512
BATCH=2048
THREADS=8
GPU_LAYERS=99

KV_ARGS="-ctk q8_0 -ctv q8_0 -fa on"
# Qwen3's published non-thinking defaults
SAMPLING="--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0 --repeat-penalty 1.0"
REASONING=off
EXTRA_ARGS=""

MIN_FREE_MIB=12000
EXPECT_DECODE_MS=12
EXPECT_PREFILL_TPS=3000
