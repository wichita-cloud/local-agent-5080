# FAST PROFILE: Qwen3.5-27B IQ4_XS with its MTP layer (multi-token prediction), 32k context, and it can see images.
#
# MTP: the model drafts the next few tokens with its own small extra layer and checks them all in one pass. Every
# token is still the full model's choice (a wrong guess is thrown away), so answers are the same model's answers;
# they just arrive faster. The more predictable the text (code edits, quoting, lists), the bigger the gain.
#
# The file: the default IQ4_XS was converted without the MTP layer, and the quants that include it are ~1 GB bigger,
# too big for 32k on 16 GB. So `bin/model.sh download` takes the default file (or the one you already have) and adds
# just the official MTP layer (~250 MB) from unsloth's MTP build of the same model (bin/mtp-graft.py). Your
# original file is kept unchanged; this makes a second ~14 GB file next to it.
#
# Measured on an RTX 5080 / WSL2 (display on the iGPU), 2026-10-18:
#   * needs the newer llama.cpp build (pinned below), -fit off (see qwen3.5-27b-iq4xs-64k.env) and the 4-bit cache:
#     the MTP layer and its working memory take ~770 MB, which q8_0 at 32k doesn't leave.
#   * 32k is the limit for a safe margin: 45k spilled (decode ~70 ms/token), 40k ran but left only ~200 MB.
#   * the image encoder runs on the CPU: zero VRAM.

DESCRIPTION="Qwen3.5-27B dense + MTP, 32k context + images (fastest; newer llama.cpp build)"
MODEL_FILE=Qwen3.5-27B.i1-IQ4_XS-mtp.gguf       # built by bin/model.sh download from the two sources below
BASE_FILE=Qwen3.5-27B.i1-IQ4_XS.gguf            # the default profile's file (downloaded from MODEL_URL if missing)
MODEL_URL="https://huggingface.co/mradermacher/Qwen3.5-27B-i1-GGUF/resolve/main/Qwen3.5-27B.i1-IQ4_XS.gguf"
MTP_DONOR_URL="https://huggingface.co/unsloth/Qwen3.5-27B-MTP-GGUF/resolve/main/Qwen3.5-27B-IQ4_XS.gguf"   # only its MTP layer is downloaded
MEASURED=yes
MIN_BYTES=14000000000

MMPROJ_FILE=Qwen3.5-27B.mmproj-Q8_0.gguf
MMPROJ_URL="https://huggingface.co/mradermacher/Qwen3.5-27B-GGUF/resolve/main/Qwen3.5-27B.mmproj-Q8_0.gguf"
MMPROJ_MIN_BYTES=600000000

LLAMA_IMAGE_PROFILE=ghcr.io/ggml-org/llama.cpp@sha256:7149a45c80596644320de1d565db1b3b8e70b22c66fed612e69b73f6b1e0d746

CTX=32768
UBATCH=128
BATCH=512
THREADS=8
GPU_LAYERS=99

KV_ARGS="-ctk q4_0 -ctv q4_0 -fa on"

SAMPLING="--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0 --repeat-penalty 1.0"
REASONING=off
EXTRA_ARGS="-fit off --spec-type draft-mtp --spec-draft-n-max 3"   # 3 drafted tokens per step (the setting measured here)

MIN_FREE_MIB=14200
EXPECT_DECODE_MS=9       # bench.sh's counting test is very predictable text, so MTP shines (measured: 8.6 ms/token;
                         # prose ~12.4, 14.8 after the ~18k prompt). Above 13.5 = MTP not working or a spill.
EXPECT_PREFILL_TPS=1500  # measured: ~1,575 tok/s
