# MoE PROFILE: Qwen3.5-35B-A3B (mixture of experts: 256 experts, 8 active), IQ4_XS (~18 GB file).
# The file is bigger than VRAM, so some expert layers stay in system RAM (--n-cpu-moe). Because only ~3B
# parameters are active per token, it is still quick. It has more total knowledge, but tool use is less
# predictable than the dense 27B.
#
# The flags below were tested on an RTX 5080 with a model of this architecture and quant.
# Re-measure with bin/bench.sh. EXPECT_* values are rough until you do, so update them from your bench.

DESCRIPTION="Qwen3.5-35B-A3B MoE, IQ4_XS, 48k context, experts partly in system RAM"
MODEL_FILE=Qwen3.5-35B-A3B.i1-IQ4_XS.gguf
MODEL_URL="https://huggingface.co/mradermacher/Qwen3.5-35B-A3B-i1-GGUF/resolve/main/Qwen3.5-35B-A3B.i1-IQ4_XS.gguf"   # the console's Download button / bin/model.sh download use this
MEASURED=no         # yes = EXPECT_* below came from bench.sh on an RTX 5080; no = estimates until you bench
MIN_BYTES=17000000000
CTX=49152
UBATCH=4096
BATCH=4096
THREADS=7        # MoE CPU experts want real cores; leave one for the system
GPU_LAYERS=99
KV_ARGS="-ctk q8_0 -ctv q8_0 -fa on"
SAMPLING="--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0 --repeat-penalty 1.0"
REASONING=off
EXTRA_ARGS="--n-cpu-moe 18"   # experts of the first 18 layers stay in RAM; lower = faster but more VRAM
MIN_FREE_MIB=14000
EXPECT_DECODE_MS=30
EXPECT_PREFILL_TPS=800
