# LONG-CONTEXT MoE PROFILE (optional, 128k): the 32k Bolt profile with the experts of 6 more layers in system RAM to
# make room for the cache. Measured 2026-10-28: 958 MiB VRAM free after a 118k-token prompt, 8/8 facts recalled at 118k,
# decode 21.8-22.6 ms/token short and ~26 ms/token at 118k, prefill ~1,450-1,900 tok/s. 4-bit cache was slower deep in
# (39 ms/token at 118k). 256k also fits (q4 cache, n-cpu-moe 46: 8/8 at 237k, 58-60 ms/token there).
#
# MoE PROFILE (optional): NVIDIA Nemotron 3.5 Bolt 74B-A9B, NVIDIA's own native 2-bit GGUF (22 GB), released 2026-10-15.
# A Mamba-2 / attention hybrid "LatentMoE": 74B parameters in total, 9B used per token. NVIDIA's recipes are for 28-32 GB
# cards; on a 16 GB 5080 the experts of some layers stay in system RAM (--n-cpu-moe), like the Qwen3.5 35B profile.
# License: OpenMDW-1.1 (commercial use allowed). Needs a llama.cpp from 2026-10-15 or later (PR 30520), pinned below.
#
# Measured 2026-10-28 on an RTX 5080, 32 GB RAM, no other WSL distro running: 19.2 ms/token, ~1,600-2,200 tok/s prefill,
# ~300 MiB VRAM left. With WSL swapping, prefill fell to ~450-700 tok/s (see docs/MODELS.md).

DESCRIPTION="Nemotron 3.5 Bolt 74B-A9B MoE, NVIDIA 2-bit, 128k context, experts partly in system RAM (needs 32 GB RAM)"
MODEL_FILE=NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB.gguf
MODEL_URL="https://huggingface.co/nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-GGUF/resolve/main/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB.gguf"
MODEL_SHA256=91d63363e782c8a3d5f4be42816eba8e0d42dd2530bd07a7d0d2dc440599af75   # Hugging Face's LFS hash, 2026-10-26
MEASURED=yes
MIN_BYTES=21500000000
CTX=131072
UBATCH=2048      # measured 2026-10-27 (WSL swapping): prefill +~50% over 512; 1024 no gain, 4096 slower (spill)
BATCH=2048
THREADS=7        # MoE CPU experts want real cores; leave one for the system
GPU_LAYERS=99
KV_ARGS="-ctk q8_0 -ctv q8_0 -fa on"
SAMPLING="--temp 1.0 --top-p 0.95"     # NVIDIA's recommendation for text
REASONING=off
# --n-cpu-moe 46: the experts of layers 0-45 stay in system RAM (6 more than the 32k profile, to make room for the
# bigger cache; 46 and 48 are the same, layers 46-47 hold no experts), the rest on the card. Tuned by measurement.
# -fit off: the automatic fitting keeps a 1 GiB reserve (see the 64k profile).
# --cache-ram 2048: llama.cpp keeps up to 8 GiB of prompt cache in system RAM by default; with ~7 GiB of experts there
# too, that would push a 32 GB PC's WSL (20 GB cap) to its limit.
EXTRA_ARGS="-fit off --n-cpu-moe 46 --cache-ram 2048"
MIN_FREE_MIB=14000
# Windows counts llama.cpp's pinned system-RAM buffers for the CPU experts as "shared GPU memory" (~336 MiB at 32k,
# +64 MiB per 16k of context). Measured 2026-10-28: decode stays ~20 ms/token with them, so they are not a spill.
SPILL_MAX_MIB=900   # ~720 MiB at 128k
EXPECT_DECODE_MS=20
EXPECT_PREFILL_TPS=1800   # the first prompt after loading measured 1,310 (bench warns below 1,200)

# llama.cpp b11889 (2026-10-25), pinned by digest: the first builds with Bolt support are from 2026-10-15.
LLAMA_IMAGE_PROFILE=ghcr.io/ggml-org/llama.cpp@sha256:b51c252687249a6990ae1c168156cb215c954bfd71f9c434eda9a065b1a40dbe
