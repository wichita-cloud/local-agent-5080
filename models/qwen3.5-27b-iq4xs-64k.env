# LONG-CONTEXT PROFILE: the same Qwen3.5-27B IQ4_XS file as the default, at 64k context, and it can see images.
# Replaces the old 45k profile as the way to get more context: double the default's context, with MORE spare VRAM
# than 45k had, because the KV cache is 4-bit here.
#
# What makes 64k fit, measured on an RTX 5080 / WSL2 (display on the iGPU), 2026-10-18:
#   * a newer llama.cpp build (pinned below) whose 4-bit V cache works on this hybrid architecture. On the
#     stack-wide May build it does not (34 graph splits), which is why only this profile uses q4_0.
#   * -fit off: the newer build's automatic fitting leaves a 1 GiB reserve and, with every layer forced onto the GPU,
#     spills instead (prompt reading ~85 tok/s). Off, it loads exactly like the May build.
#   * never q8_0 K with q4_0 V: that mix takes a broken path (prompt reading ~60 tok/s). 90k spills.
#   * the image encoder runs on the CPU (llama-up.sh does this whenever MMPROJ_FILE is set): zero VRAM.
# The cost: replies late in a long conversation are ~25% slower than at 32k (more cache to read per token).

DESCRIPTION="Qwen3.5-27B dense, IQ4_XS, 64k context + images (newer llama.cpp build)"
MODEL_FILE=Qwen3.5-27B.i1-IQ4_XS.gguf    # the same file as the default profile: nothing extra to download
MODEL_URL="https://huggingface.co/mradermacher/Qwen3.5-27B-i1-GGUF/resolve/main/Qwen3.5-27B.i1-IQ4_XS.gguf"
MEASURED=yes
MIN_BYTES=14000000000

# Image understanding: the vision projector for this model (~630 MB, stays in system RAM). Without the file the
# profile still runs, text only. OpenClaw shrinks images to 1200 px first: ~1,000 tokens and ~20 s per image.
MMPROJ_FILE=Qwen3.5-27B.mmproj-Q8_0.gguf
MMPROJ_URL="https://huggingface.co/mradermacher/Qwen3.5-27B-GGUF/resolve/main/Qwen3.5-27B.mmproj-Q8_0.gguf"
MMPROJ_MIN_BYTES=600000000

# llama.cpp b11277 (2026-09-30), pinned by digest. Only this profile and the MTP one use it.
LLAMA_IMAGE_PROFILE=ghcr.io/ggml-org/llama.cpp@sha256:7149a45c80596644320de1d565db1b3b8e70b22c66fed612e69b73f6b1e0d746

CTX=65536
UBATCH=128
BATCH=512
THREADS=8
GPU_LAYERS=99

# 4-bit K AND V together, on the pinned newer build only (see the header). Measured: same prompt reading speed as
# q8_0, and long-context recall still 8/8 at a 57k-token prompt.
KV_ARGS="-ctk q4_0 -ctv q4_0 -fa on"

SAMPLING="--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0 --repeat-penalty 1.0"
REASONING=off
EXTRA_ARGS="-fit off"    # load-bearing on this build: see the header

MIN_FREE_MIB=14200
EXPECT_DECODE_MS=21      # bench.sh warns above 1.5x this (measured: 20.5 ms/token; 29 ms after its ~18k prompt)
EXPECT_PREFILL_TPS=1500  # bench.sh warns below 2/3 of this (measured: ~1,700 tok/s)
