# DEFAULT PROFILE: Qwen3.5-27B (dense), imatrix IQ4_XS, 32k context.
# Chosen for stability on 16 GB: the whole model, KV cache and compute buffers live in VRAM, with ~600 MB to spare.
# All numbers below were measured on an RTX 5080 16 GB / Ryzen 9 9900X / 32 GB RAM / WSL2, display on the iGPU.

DESCRIPTION="Qwen3.5-27B dense, IQ4_XS, 32k context (default; most stable)"
MODEL_FILE=Qwen3.5-27B.i1-IQ4_XS.gguf    # rename yours to match, or edit this line
MODEL_URL="https://huggingface.co/mradermacher/Qwen3.5-27B-i1-GGUF/resolve/main/Qwen3.5-27B.i1-IQ4_XS.gguf"   # the console's Download button / bin/model.sh download use this
MEASURED=yes         # yes = EXPECT_* below came from bench.sh on an RTX 5080; no = estimates until you bench
MIN_BYTES=14000000000                    # ~13.7 GiB. A truncated GGUF loads far enough to look alive, then serves garbage.

CTX=32768        # KV costs ~34 MiB per 1k tokens on this model (only 16 of its 64 blocks carry a KV cache)
UBATCH=128       # compute buffer scales with this; 128 → ~124 MiB. Raising it costs VRAM, not speed (prefill is not ub-bound here)
BATCH=512
THREADS=8        # must equal the number of cores in LLAMA_CPUSET
GPU_LAYERS=99    # everything on the GPU

# Load-bearing: q8_0 for BOTH caches. A quantized V cache (q4_0) breaks the GPU path on this hybrid
# architecture: 34 graph splits instead of 2, and prompt reading 20x slower. See docs/TUNING.md.
KV_ARGS="-ctk q8_0 -ctv q8_0 -fa on"

# Qwen's published non-thinking defaults. Reasoning is off because the server's default reasoning format
# leaves <think> text inside replies for some clients; see docs/TUNING.md to turn it back on properly.
SAMPLING="--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0 --repeat-penalty 1.0"
REASONING=off
EXTRA_ARGS=""

MIN_FREE_MIB=14200       # llama-up.sh waits for this much free VRAM before launching
EXPECT_DECODE_MS=21      # bench.sh warns above 1.5x this (healthy measured: 20.0 ms/token)
EXPECT_PREFILL_TPS=1500  # bench.sh warns below 2/3 of this (measured: ~1,650 tok/s)
